# 密钥环境变量示例（不含真实值，可安全入库）
#
# 用法：
#   1. 复制本文件到「仓库之外」的位置，例如 C:\Users\leshi\devtools\.env.local
#      （仓库内的 .env.local 已被 .gitignore 忽略，但放仓库外更安全）
#   2. 填入真实值
#   3. bash cathouse-dev.sh start 会自动 source 它注入环境变量
#   4. IDEA 用户：Run/Debug Configurations → Environment variables 手动添加同名变量

# 微信小程序 AppSecret（微信公众平台 → 开发管理 → 开发设置）
export CATHOUSE_WECHAT_SECRET=你的AppSecret

# token 签名密钥，随便一个长随机串即可：openssl rand -hex 32
# ⚠️ 换掉这个值会让所有已签发的 token 立即失效（用户需重新登录）
export CATHOUSE_AUTH_SECRET=请替换为随机字符串
