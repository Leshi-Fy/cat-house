.mvn/wrapper/maven-wrapper.jar

# 后端运行时上传目录（用户上传的图片等，不入库）
uploads/
server/uploads/

# 本地私密笔记（含 Supabase / 数据库 / AppSecret 明文），严禁入库
cathouse.txt
*.local.yml
application-local.yml

# 环境变量文件（密钥类，严禁入库）
.env
.env.local
.env.*
!.env.example

# 后端本地运行日志（cathouse-dev.sh 启动 jar 时产生）
server/*.out
server/*.err
