/**
 * 猫屋小程序 - 全局样式
 * 设计规范：暖橙色 #FF8C42 + 奶白色 #FFF8F0，圆角卡片，温暖可爱公益风格
 */

/* ===== CSS 变量 ===== */
page {
  --color-primary: #FF8C42;
  --color-primary-light: #FFB07A;
  --color-primary-dark: #E67328;
  --color-bg: #FFF8F0;
  --color-white: #FFFFFF;
  --color-text: #333333;
  --color-text-secondary: #666666;
  --color-text-light: #999999;
  --color-border: #F0E6D8;
  --color-success: #52C41A;
  --color-warning: #FAAD14;
  --color-danger: #FF4D4F;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --shadow-card: 0 4rpx 16rpx rgba(255, 140, 66, 0.08);
  --shadow-elevated: 0 8rpx 32rpx rgba(255, 140, 66, 0.12);

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

/* ===== 通用工具类 ===== */
.container {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: var(--color-white);
  border: none;
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1;
  box-shadow: 0 6rpx 20rpx rgba(255, 140, 66, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-lg);
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

.btn-outline::after {
  border: none;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(255, 140, 66, 0.12);
  color: var(--color-primary);
}

.tag-success {
  background: rgba(82, 196, 26, 0.12);
  color: var(--color-success);
}

.tag-warning {
  background: rgba(250, 173, 20, 0.12);
  color: var(--color-warning);
}

.tag-danger {
  background: rgba(255, 77, 79, 0.12);
  color: var(--color-danger);
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* Flex 布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* 文本 */
.text-primary {
  color: var(--color-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-light {
  color: var(--color-text-light);
}

.text-bold {
  font-weight: 600;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分割线 */
.divider {
  width: 100%;
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* 猫爪装饰 */
.paw-decoration {
  position: relative;
}

.paw-decoration::before {
  content: '🐾';
  position: absolute;
  font-size: 24rpx;
  opacity: 0.15;
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 图片填充 */
.img-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 页面底部留白（给 tabBar） */
.page-with-tabbar {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
