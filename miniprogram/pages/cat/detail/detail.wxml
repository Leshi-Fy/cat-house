<!--
  流浪猫详情页
-->
<view class="page">
  <!-- 照片轮播 -->
  <swiper 
    class="photo-swiper" 
    wx:if="{{cat && cat.photos.length > 0}}"
    indicator-dots="{{cat.photos.length > 1}}"
    indicator-color="rgba(255,255,255,0.4)"
    indicator-active-color="#FF8C42"
    circular
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{cat.photos}}" wx:key="index">
      <image 
        class="swiper-photo" 
        src="{{item}}" 
        mode="aspectFill" 
        bindtap="onPreviewPhoto"
      />
    </swiper-item>
    <view class="photo-counter" bindtap="onPreviewPhoto">
      {{currentPhotoIndex + 1}}/{{cat.photos.length}}
    </view>
  </swiper>

  <view class="container" wx:if="{{cat && !loading}}">
    <!-- 名字 & 基本信息 -->
    <view class="info-card card">
      <!-- 名字 + 性别徽章（性别未知时不显示，避免「未知」噪音） -->
      <view class="name-row">
        <text class="cat-name">{{cat.name}}</text>
        <text class="gender-badge {{cat.gender}}" wx:if="{{cat.genderBadge}}">{{cat.genderBadge}}</text>
      </view>

      <!-- 别名（如有合并） -->
      <view class="aliases" wx:if="{{cat.aliases && cat.aliases.length > 0}}">
        <text class="alias-text">又名：{{cat.aliases.join(' / ')}}</text>
      </view>

      <!-- 状态标签：只渲染已知信息 -->
      <view class="tag-row" wx:if="{{cat.tags && cat.tags.length > 0}}">
        <text class="tag {{item.cls}}" wx:for="{{cat.tags}}" wx:key="text">{{item.text}}</text>
      </view>

      <!-- 外貌/描述 -->
      <view class="desc" wx:if="{{cat.description}}">
        <view class="desc-bar"></view>
        <text class="desc-text">{{cat.description}}</text>
      </view>

      <view class="divider" wx:if="{{cat.metaItems && cat.metaItems.length > 0}}"></view>

      <!-- 元信息：值在上、标签在下，列间加分隔线 -->
      <view class="meta-grid" wx:if="{{cat.metaItems && cat.metaItems.length > 0}}">
        <block wx:for="{{cat.metaItems}}" wx:key="label">
          <view class="meta-divider" wx:if="{{index > 0}}"></view>
          <view class="meta-cell">
            <text class="meta-value {{item.highlight ? 'meta-value-hl' : ''}}">{{item.value}}</text>
            <text class="meta-label">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 活动区域地图（仅流浪猫） -->
    <view class="location-card card" wx:if="{{catType === 'stray' && cat.location}}">
      <view class="card-title">📍 活动区域</view>
      <map 
        class="location-map"
        latitude="{{mapLatitude}}"
        longitude="{{mapLongitude}}"
        scale="{{mapScale}}"
        markers="{{markers}}"
        circles="{{circles}}"
        show-location
      />
      <button class="btn-outline location-btn" bindtap="onOpenLocation">
        🧭 导航到这里
      </button>
    </view>

    <!-- 合并记录（仅流浪猫） -->
    <view class="merge-card card" wx:if="{{catType === 'stray' && cat.mergeChain && cat.mergeChain.length > 0}}">
      <view class="card-title">🔗 档案合并记录</view>
      <view class="merge-item" wx:for="{{cat.mergeChain}}" wx:key="mergeId">
        <text class="merge-text">{{item.catName}} 的档案已合并于此</text>
        <text class="merge-time">{{item.mergedByName}} · {{item.mergedTime}}</text>
      </view>
    </view>

    <!-- 众筹列表（仅流浪猫） -->
    <view class="crowd-list-card card" wx:if="{{catType === 'stray' && crowdfunds.length > 0}}">
      <view class="card-title">❤️ 爱心众筹 <text class="crowd-count">{{crowdfunds.length}}个</text></view>
      <view class="crowd-item" wx:for="{{crowdfunds}}" wx:key="_id" bindtap="onCrowdDetail" data-id="{{item._id}}">
        <view class="crowd-item-top">
          <text class="crowd-type-tag tag tag-primary">{{item.typeText}}</text>
          <text class="crowd-status {{item.status === 'ongoing' ? 'status-active' : item.status === 'completed' ? 'status-done' : ''}}">{{item.statusText}}</text>
          <text class="crowd-time">{{item.timeText}}</text>
        </view>
        <text class="crowd-desc text-ellipsis">{{item.description}}</text>
        <view class="crowd-progress">
          <view class="crowd-bar"><view class="crowd-bar-fill" style="width: {{item.percent}}%"></view></view>
          <view class="crowd-money">
            <text class="crowd-raised">¥{{item.raisedDisplay}}</text>
            <text class="crowd-target">目标 ¥{{item.targetDisplay}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作（仅流浪猫） -->
    <view class="bottom-actions safe-bottom" wx:if="{{catType === 'stray'}}">
      <button class="btn-outline merge-btn" bindtap="onMergeTap" wx:if="{{!isOwner}}">
        🔗 申请合并
      </button>
      <button class="btn-outline edit-btn" bindtap="onOpenEdit" wx:if="{{isOwner}}">
        ✏️ 更新信息
      </button>
      <button class="btn-primary crowd-btn" bindtap="onCrowdTap">
        ❤️ 发起众筹
      </button>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="paw-loading-icon">🐾</text>
  </view>

  <!-- 合并弹窗 -->
  <view class="modal-mask" wx:if="{{showMergeModal}}" bindtap="onCancelMerge">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">申请合并猫咪档案</view>
      <view class="modal-desc">
        你认为「{{cat.name}}」和你创建的某只流浪猫是同一只猫，申请合并后由对方审核。审核通过后，两个档案将合为一个。
      </view>
      <textarea 
        class="modal-textarea" 
        placeholder="说明为什么认为它们是同一只猫..."
        value="{{mergeNote}}" 
        bindinput="onMergeNoteInput"
      />
      <view class="modal-actions">
        <button class="btn-outline modal-btn" bindtap="onCancelMerge">取消</button>
        <button class="btn-primary modal-btn" bindtap="onSubmitMerge">选择我的猫咪</button>
      </view>
    </view>
  </view>

  <!-- 手动更新数据弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onMaskTapEdit">
    <view class="modal-content edit-modal-content" catchtap="noop">
      <view class="modal-title">更新猫咪信息</view>

      <view class="edit-row">
        <view class="edit-form-item edit-half" catchtap="onPickerTap">
          <text class="edit-label">性别</text>
          <picker mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" bindchange="onEditGenderChange">
            <view class="edit-picker">{{genderLabels[genderIndex]}} ▾</view>
          </picker>
        </view>
        <view class="edit-form-item edit-half">
          <text class="edit-label">当前年龄</text>
          <input class="edit-input" placeholder="如：1岁6个月" value="{{editForm.ageText}}" bindinput="onEditAgeInput" />
        </view>
      </view>

      <view class="edit-row">
        <view class="edit-form-item edit-half" catchtap="onPickerTap">
          <text class="edit-label">健康状况</text>
          <picker mode="selector" range="{{healthLabels}}" value="{{healthIndex}}" bindchange="onEditHealthChange">
            <view class="edit-picker">{{healthLabels[healthIndex]}} ▾</view>
          </picker>
        </view>
        <view class="edit-form-item edit-half" catchtap="onPickerTap">
          <text class="edit-label">当前状态</text>
          <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="onEditStatusChange">
            <view class="edit-picker">{{statusLabels[statusIndex]}} ▾</view>
          </picker>
        </view>
      </view>

      <view class="edit-form-item">
        <text class="edit-label">最新目击备注</text>
        <input class="edit-input" placeholder="留空则不更新目击时间" value="{{editForm.lastSeenNote}}" bindinput="onEditLastSeenInput" />
      </view>

      <view class="edit-form-item">
        <text class="edit-label">外貌/描述更新</text>
        <textarea class="edit-textarea" placeholder="更新猫咪描述（可选）" value="{{editForm.description}}" bindinput="onEditDescInput" auto-height />
      </view>

      <view class="modal-actions">
        <button class="btn-outline modal-btn" bindtap="onCloseEdit">取消</button>
        <button class="btn-primary modal-btn" bindtap="onSubmitEdit" disabled="{{isSubmittingEdit}}">
          {{isSubmittingEdit ? '保存中...' : '保存'}}
        </button>
      </view>
    </view>
  </view>
</view>
