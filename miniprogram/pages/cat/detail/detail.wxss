/**
 * 流浪猫详情页样式
 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 照片轮播 */
.photo-swiper {
  width: 100%;
  height: 560rpx;
  position: relative;
}

.swiper-photo {
  width: 100%;
  height: 100%;
}

.photo-counter {
  position: absolute;
  bottom: 24rpx;
  right: 32rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 信息卡片 */
.info-card {
  margin-top: -48rpx;
  position: relative;
  z-index: 10;
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx 24rpx;
  box-shadow: var(--shadow-elevated);
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.cat-name {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

/* 性别徽章：只在已知性别时渲染（未知不显示） */
.gender-badge {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.3;
  background: rgba(120, 130, 150, 0.1);
  color: var(--color-text-secondary);
  transform: translateY(2rpx);
}

.gender-badge.male {
  background: rgba(91, 155, 213, 0.14);
  color: #3E7BB6;
}

.gender-badge.female {
  background: rgba(255, 133, 162, 0.16);
  color: #E5698D;
}

.aliases {
  margin-bottom: 12rpx;
}

.alias-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag-neutral {
  background: rgba(120, 130, 150, 0.1);
  color: #6B7280;
}

.tag-age {
  background: rgba(255, 140, 66, 0.12);
  color: var(--color-primary);
}

/* 描述：左侧竖条引用样式 */
.desc {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.desc-bar {
  width: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, var(--color-primary), rgba(255, 176, 122, 0.35));
  flex-shrink: 0;
}

.desc-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* 元信息网格：值在上、标签在下，列间 1rpx 分隔线 */
.meta-grid {
  display: flex;
  align-items: center;
}

.meta-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.meta-divider {
  width: 1rpx;
  height: 44rpx;
  background: var(--color-border);
  flex-shrink: 0;
}

.meta-label {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.meta-value {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-value-hl {
  color: var(--color-primary);
}

/* 地图卡片 */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 22rpx;
}

.location-map {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}

.location-btn {
  width: 100% !important;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 !important;
  font-size: 28rpx !important;
  font-weight: 600;
  background: rgba(255, 140, 66, 0.1);
  border: none;
  color: var(--color-primary);
  border-radius: var(--radius-md);
}

.location-btn:active {
  opacity: 0.75;
}

/* 合并记录 */
.merge-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.merge-item:last-child {
  border-bottom: none;
}

.merge-text {
  font-size: 26rpx;
  color: var(--color-text);
  display: block;
}

.merge-time {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
  display: block;
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 0 0;
}

.merge-btn, .crowd-btn, .edit-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 29rpx !important;
  border-radius: 999rpx;
}

/* 次要操作：浅描边样式，让「发起众筹」成为唯一视觉重心 */
.merge-btn, .edit-btn {
  background: var(--color-white);
  border: 2rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-weight: 500;
  box-shadow: var(--shadow-card);
}

.merge-btn:active, .edit-btn:active {
  opacity: 0.7;
}

.crowd-btn {
  font-weight: 600;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.paw-loading-icon {
  font-size: 80rpx;
  animation: pawBounce 1.2s ease-in-out infinite;
}

@keyframes pawBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.modal-content {
  width: 100%;
  background: var(--color-white);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.modal-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
}

/* 众筹列表 */
.crowd-list-card {
  padding: 28rpx;
}

.crowd-count {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-light);
}

.crowd-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.crowd-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.crowd-item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.crowd-status {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.crowd-status.status-active {
  color: #4CAF50;
}

.crowd-status.status-done {
  color: var(--color-text-light);
}

.crowd-time {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-left: auto;
}

.crowd-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.crowd-bar {
  height: 12rpx;
  background: var(--color-bg);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.crowd-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42, #FF6B6B);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.crowd-money {
  display: flex;
  justify-content: space-between;
}

.crowd-raised {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.crowd-target {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 编辑弹窗 */
.edit-modal-content {
  max-height: 85vh;
  overflow-y: auto;
}

.edit-form-item {
  margin-bottom: 28rpx;
}

/* 弹窗里的两列布局 */
.edit-row {
  display: flex;
  gap: 20rpx;
}

.edit-half {
  flex: 1;
  min-width: 0;
}

.edit-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.edit-input {
  width: 100%;
  height: 72rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.edit-picker {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.edit-textarea {
  width: 100%;
  min-height: 120rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
