/**
 * 探索页样式
 */

.page {
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 32rpx;
  background: var(--color-white);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 合并提示 */
.merge-tip {
  background: rgba(255, 140, 66, 0.08);
  color: var(--color-primary);
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
}

/* 列表 */
.cat-list {
  padding: 16rpx 32rpx;
}

.cat-item {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
}

.cat-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.cat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.cat-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 600;
}

.cat-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.cat-meta-row {
  display: flex;
  gap: 12rpx;
}

.meta-text {
  font-size: 22rpx;
  color: var(--color-text-light);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  color: var(--color-text-light);
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
}
