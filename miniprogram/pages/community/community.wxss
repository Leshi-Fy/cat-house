/* pages/community/community.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  background: #FFF8F0;
  min-height: 100vh;
}

/* ─── 统一列表 ─── */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* ─── 众筹卡片 ─── */
.crowd-card {
  position: relative;
}

.crowd-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.crowd-cat-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.crowd-cat-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.crowd-cat-text {
  display: flex;
  flex-direction: column;
}

.crowd-cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.crowd-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.crowd-status-badge {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #FF8C42, #FF6B6B);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.crowd-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.crowd-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.crowd-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.crowd-photo.single {
  width: 100%;
  max-width: 400rpx;
  height: 300rpx;
}

.crowd-progress-section {
  margin-bottom: 20rpx;
}

.crowd-progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.crowd-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42, #FF6B6B);
  border-radius: 6rpx;
  min-width: 4rpx;
  transition: width 0.3s ease;
}

.crowd-amount-row {
  display: flex;
  justify-content: space-between;
}

.crowd-raised {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF6B35;
}

.crowd-target {
  font-size: 24rpx;
  color: #999;
}

.crowd-donate-btn {
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
  transition: transform 0.2s;
}

.crowd-donate-btn:active {
  transform: scale(0.97);
}

/* ─── 浮动发布按钮 ─── */
.fab-post {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 53, 0.45);
  z-index: 100;
  transition: transform 0.2s ease;
}

.fab-post:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* ─── 动态卡片 ─── */
.feed-card {
  /* 和 .card 一样的基础样式，无需额外重写 */
}

/* 头部信息 */
.feed-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.feed-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 关联猫咪 */
.linked-cat {
  display: flex;
  align-items: center;
  background: #FFF5F0;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.cat-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f0f0f0;
}

.cat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.cat-breed {
  font-size: 26rpx;
  color: #666;
  margin-top: 4rpx;
}

.link-arrow {
  font-size: 40rpx;
  color: #999;
}

/* 动态内容 */
.feed-content {
  margin-bottom: 20rpx;
}

.feed-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.feed-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.feed-image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.feed-image.single {
  width: 100%;
  max-width: 400rpx;
  height: 400rpx;
}

/* 互动按钮 */
.feed-actions {
  display: flex;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.action-btn:active {
  background: #f5f5f5;
}

.action-btn.active {
  color: #FF6B35;
}

.action-btn.active .action-icon {
  color: #FF6B35;
}

.action-icon {
  font-size: 32rpx;
  color: #999;
}

.action-count {
  font-size: 26rpx;
  color: #666;
}

/* 加载状态 */
.load-more, .no-more, .empty-state {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  padding: 100rpx 40rpx;
}
