/**
 * 动态详情页样式 - 评论互动
 */

.page {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 140rpx;
}

/* 加载中 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}

/* 动态详情 */
.feed-detail {
  background: #fff;
  padding: 32rpx;
}

.feed-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.feed-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 正文 */
.feed-content {
  margin-bottom: 24rpx;
}

.feed-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
}

.feed-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.feed-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.feed-image.single {
  width: 100%;
  max-width: 480rpx;
  height: 360rpx;
}

/* 关联猫咪 */
.linked-cat {
  display: flex;
  align-items: center;
  background: #FFF5F0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.cat-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.cat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.cat-breed {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.link-arrow {
  font-size: 36rpx;
  color: #999;
}

/* 互动栏 */
.feed-actions {
  display: flex;
  gap: 48rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 34rpx;
  color: #999;
}

.action-item.active .action-icon {
  color: #FF6B6B;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

/* 分割线 */
.divider {
  height: 16rpx;
  background: #FFF8F0;
}

/* 评论区 */
.comments-section {
  background: #fff;
  padding: 32rpx;
  min-height: 300rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.comment-count {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}

/* 空评论 */
.empty-comments {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-comments-text {
  color: #ccc;
  font-size: 28rpx;
}

/* 一级评论 */
.comment-group {
  margin-bottom: 8rpx;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}

.comment-time {
  font-size: 22rpx;
  color: #bbb;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  word-break: break-all;
}

.comment-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 8rpx;
}

.reply-btn {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 0;
}

.delete-btn {
  font-size: 24rpx;
  color: #ccc;
  padding: 4rpx 0;
}

/* 回复列表 */
.replies {
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}

.reply-item {
  display: flex;
  padding: 12rpx 0;
}

.reply-item + .reply-item {
  border-top: 1rpx solid #f0f0f0;
}

.reply-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.reply-body {
  flex: 1;
  min-width: 0;
}

.reply-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
  margin-right: 12rpx;
}

.reply-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  display: block;
  word-break: break-all;
}

.reply-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 6rpx;
}

.reply-time {
  font-size: 22rpx;
  color: #ccc;
}

/* 展开更多 */
.more-replies {
  padding-top: 12rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.more-replies-text {
  font-size: 24rpx;
  color: #FF8C42;
}

/* 底部评论栏 */
.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.reply-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx;
  background: #FFF5F0;
  border-bottom: 1rpx solid #FFE8D8;
}

.reply-hint-text {
  font-size: 24rpx;
  color: #FF8C42;
}

.reply-hint-cancel {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

.comment-input-row {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
}

.send-btn {
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 36rpx;
  background: #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  min-width: 120rpx;
}

/* 有内容时 - 高亮橙色 */
.send-btn.active {
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.4);
  transform: scale(1.05);
}

/* 发送中 - 缩小半透明，防止重复点击 */
.send-btn.submitting {
  opacity: 0.7;
  transform: scale(0.95);
  pointer-events: none;
}

.send-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  transition: opacity 0.2s;
}

/* 无内容时文字半透明 */
.send-btn:not(.active) .send-btn-text {
  opacity: 0.5;
}
