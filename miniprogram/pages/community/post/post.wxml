<!--pages/community/post/post.wxml-->
<view class="container">
  <!-- 关联猫咪 -->
  <view class="section">
    <view class="section-title">
      <text>关联猫咪（可选）</text>
      <text wx:if="{{selectedCat}}" class="change-btn" bindtap="changeCat">更换</text>
    </view>
    
    <view wx:if="{{!selectedCat}}" class="select-cat" bindtap="showCatSelector">
      <text class="select-icon">+</text>
      <text class="select-text">选择一只流浪猫</text>
    </view>
    
    <view wx:if="{{selectedCat}}" class="selected-cat">
      <image class="cat-image" src="{{selectedCat.photos[0]}}" mode="aspectFill"/>
      <view class="cat-info">
        <text class="cat-name">{{selectedCat.name}}</text>
        <text class="cat-breed">{{selectedCat.breed}}</text>
      </view>
      <text class="remove-btn" bindtap="removeCat">×</text>
    </view>
  </view>

  <!-- 动态内容 -->
  <view class="section">
    <view class="section-title">动态内容</view>
    <textarea 
      class="content-input" 
      placeholder="分享关于这只猫咪的故事..."
      maxlength="500"
      bindinput="onContentInput"
      value="{{content}}"
    />
    <text class="word-count">{{content.length}}/500</text>
  </view>

  <!-- 图片上传 -->
  <view class="section">
    <view class="section-title">添加图片（最多9张）</view>
    <view class="image-list">
      <!-- 已有图片（编辑模式保留） -->
      <view wx:for="{{existingPhotos}}" wx:key="*this" class="image-item">
        <image class="uploaded-image" src="{{item}}" mode="aspectFill"/>
        <view class="delete-btn" catchtap="deleteExistingPhoto" data-index="{{index}}">×</view>
      </view>
      <!-- 新选图片 -->
      <view wx:for="{{images}}" wx:key="*this" class="image-item">
        <image class="uploaded-image" src="{{item}}" mode="aspectFill"/>
        <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">×</view>
      </view>
      <view wx:if="{{existingPhotos.length + images.length < 9}}" class="upload-btn" bindtap="chooseImage">
        <text class="upload-icon">+</text>
      </view>
    </view>
  </view>

  <!-- 发布/保存按钮 -->
  <view class="submit-section">
    <button class="submit-btn {{content ? 'active' : ''}}" bindtap="submitPost">
      {{isEditMode ? '保存修改' : '发布动态'}}
    </button>
  </view>
</view>

<!-- 猫咪选择弹窗 -->
<view class="cat-selector {{showSelector ? 'show' : ''}}" bindtap="hideCatSelector">
  <view class="selector-content" catchtap="preventHide">
    <view class="selector-header">
      <text class="selector-title">选择猫咪</text>
      <text class="close-btn" bindtap="hideCatSelector">×</text>
    </view>
    
    <!-- 搜索框 -->
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="搜索猫咪名字"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>
    
    <!-- 我的猫咪 -->
    <view wx:if="{{myCats.length > 0}}" class="cat-group">
      <view class="group-title">我创建的</view>
      <scroll-view scroll-y class="cat-list">
        <view 
          wx:for="{{myCats}}" 
          wx:key="_id"
          class="cat-option"
          bindtap="selectCat"
          data-cat="{{item}}"
        >
          <image class="option-image" src="{{item.photos[0]}}" mode="aspectFill"/>
          <view class="option-info">
            <text class="option-name">{{item.name}}</text>
            <text class="option-breed">{{item.breed}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
    
    <!-- 附近的猫咪 -->
    <view wx:if="{{nearbyCats.length > 0}}" class="cat-group">
      <view class="group-title">附近的猫咪</view>
      <scroll-view scroll-y class="cat-list">
        <view 
          wx:for="{{nearbyCats}}" 
          wx:key="_id"
          class="cat-option"
          bindtap="selectCat"
          data-cat="{{item}}"
        >
          <image class="option-image" src="{{item.photos[0]}}" mode="aspectFill"/>
          <view class="option-info">
            <text class="option-name">{{item.name}}</text>
            <text class="option-breed">{{item.breed}} · {{item.distance}}m</text>
          </view>
        </view>
      </scroll-view>
    </view>
    
    <view wx:if="{{myCats.length === 0 && nearbyCats.length === 0}}" class="empty-cats">
      <text>没有找到猫咪</text>
    </view>
  </view>
</view>
