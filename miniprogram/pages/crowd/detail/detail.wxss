/**
 * 众筹详情页样式
 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 顶部 Hero */
.hero-section {
  position: relative;
  height: 480rpx;
}

.hero-photo {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx 28rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

/* 金额进度 */
.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.raised-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.target-amount {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.progress-meta {
  display: flex;
  justify-content: space-between;
}

.progress-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.progress-deadline {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.progress-deadline.expired {
  color: var(--color-danger);
}

/* 描述 */
.desc-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.info-value {
  font-size: 26rpx;
  color: var(--color-text);
}

/* 记录卡片（捐款 + 报销统一） */
.records-card {
  margin-top: 20rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  flex: 1;
  margin-right: 20rpx;
}

.record-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.record-time {
  font-size: 22rpx;
  color: var(--color-text-light);
  display: block;
  margin-top: 4rpx;
}

.record-remark {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.donate-color {
  color: #4CAF50;
}

.receipt-color {
  color: #FF6B35;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 20rpx 0;
}

.empty-tip-text {
  font-size: 26rpx;
  color: var(--color-text-light);
}

/* 报销状态标签 */
.receipt-status-tag {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.receipt-status-tag.pending {
  background: #FFF3E0;
  color: #FF8C42;
}

.receipt-status-tag.approved {
  background: #E8F5E9;
  color: #4CAF50;
}

.receipt-status-tag.rejected {
  background: #FFEBEE;
  color: #F44336;
}

/* 发票图片 */
.receipt-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.receipt-photo-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 24rpx;
  margin-top: 20rpx;
}

.donate-btn, .receipt-btn {
  flex: 1;
  font-size: 28rpx !important;
}

/* 可报销余额提示 */
.balance-hint {
  display: flex;
  flex-direction: column;
  background: #FFF8F0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.bh-main { font-size: 28rpx; font-weight: 600; color: #FF6B35; }
.bh-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* 底部演示 / 开发中 提示 */
.dev-tip {
  width: 100%;
  font-size: 22rpx;
  color: #FF8C42;
  background: #FFF1E6;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.paw-loading-icon {
  font-size: 80rpx;
  animation: pawBounce 1.2s ease-in-out infinite;
}

@keyframes pawBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

/* ===== 互动条：点赞 / 评论 ===== */
.interact-card {
  display: flex;
  align-items: center;
  gap: 64rpx;
}

.interact-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}

.interact-icon {
  font-size: 34rpx;
  color: #bbb;
  transition: color 0.2s;
}

.interact-btn.active .interact-icon {
  color: #FF6B6B;
}

.interact-count {
  font-size: 26rpx;
  color: #999;
}

.interact-btn.active .interact-count {
  color: #FF6B6B;
}

/* ===== 评论区 ===== */
.comments-card {
  padding-bottom: 24rpx;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0 8rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.comment-placeholder {
  color: #bbb;
}

.comment-send {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: #E0E0E0;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.comment-send.active {
  background: linear-gradient(135deg, #FF8C42, #FF6B6B);
}

.reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx;
  background: #FFF5F0;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.reply-bar-text {
  font-size: 24rpx;
  color: #FF8C42;
}

.reply-cancel {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 8rpx;
}

.comment-list {
  margin-top: 8rpx;
}

.comment-group {
  margin-bottom: 8rpx;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}

.comment-time {
  font-size: 22rpx;
  color: #bbb;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  word-break: break-all;
}

.comment-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 8rpx;
}

.reply-btn {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 0;
}

.delete-btn {
  font-size: 24rpx;
  color: #ccc;
  padding: 4rpx 0;
}

.replies {
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}

.reply-item {
  display: flex;
  padding: 12rpx 0;
}

.reply-item + .reply-item {
  border-top: 1rpx solid #f0f0f0;
}

.reply-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.reply-body {
  flex: 1;
  min-width: 0;
}

.reply-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
  margin-right: 12rpx;
}

.reply-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  display: block;
  word-break: break-all;
}

.reply-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 6rpx;
}

.reply-time {
  font-size: 22rpx;
  color: #ccc;
}

.more-replies {
  padding-top: 12rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.more-replies-text {
  font-size: 24rpx;
  color: #FF8C42;
}
