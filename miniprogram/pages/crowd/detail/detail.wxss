/**
 * 众筹详情页样式
 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 顶部 Hero */
.hero-section {
  position: relative;
  height: 480rpx;
}

.hero-photo {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx 28rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

/* 金额进度 */
.amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.raised-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.target-amount {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.progress-meta {
  display: flex;
  justify-content: space-between;
}

.progress-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.progress-deadline {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.progress-deadline.expired {
  color: var(--color-danger);
}

/* 描述 */
.desc-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.info-value {
  font-size: 26rpx;
  color: var(--color-text);
}

/* 记录卡片（捐款 + 报销统一） */
.records-card {
  margin-top: 20rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  flex: 1;
  margin-right: 20rpx;
}

.record-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.record-time {
  font-size: 22rpx;
  color: var(--color-text-light);
  display: block;
  margin-top: 4rpx;
}

.record-remark {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.donate-color {
  color: #4CAF50;
}

.receipt-color {
  color: #FF6B35;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 20rpx 0;
}

.empty-tip-text {
  font-size: 26rpx;
  color: var(--color-text-light);
}

/* 报销状态标签 */
.receipt-status-tag {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.receipt-status-tag.pending {
  background: #FFF3E0;
  color: #FF8C42;
}

.receipt-status-tag.approved {
  background: #E8F5E9;
  color: #4CAF50;
}

.receipt-status-tag.rejected {
  background: #FFEBEE;
  color: #F44336;
}

/* 发票图片 */
.receipt-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.receipt-photo-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
}

/* 底部操作 */
.bottom-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 24rpx;
  margin-top: 20rpx;
}

.donate-btn, .receipt-btn {
  flex: 1;
  font-size: 28rpx !important;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.paw-loading-icon {
  font-size: 80rpx;
  animation: pawBounce 1.2s ease-in-out infinite;
}

@keyframes pawBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}
