<!--
  报销申请页
-->
<view class="page">
  <view class="container">
    <view class="section card">
      <view class="section-title">发票照片 *</view>
      <view class="photo-grid">
        <view class="photo-item" wx:for="{{receipts}}" wx:key="index">
          <image class="photo-img" src="{{item}}" mode="aspectFill" />
          <view class="photo-delete" bindtap="onDeleteReceipt" data-index="{{index}}">✕</view>
        </view>
        <view class="photo-add" bindtap="addReceipt" wx:if="{{receipts.length < 9}}">
          <text>+</text>
        </view>
      </view>
    </view>

    <view class="section card">
      <view class="section-title">报销金额 *</view>
      <view class="amount-wrap">
        <text class="prefix">¥</text>
        <input class="amount-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onInputAmount" />
      </view>
    </view>

    <view class="section card">
      <view class="section-title">备注说明</view>
      <textarea class="remark-input" placeholder="说明报销用途..." value="{{remark}}" bindinput="onInputRemark" maxlength="500" />
    </view>

    <view class="submit-wrap safe-bottom">
      <button class="btn-primary submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '📋 提交报销申请'}}
      </button>
      <text class="tip-text">提交后由管理员审核</text>
    </view>
  </view>
</view>
