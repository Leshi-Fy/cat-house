.page { min-height: 100vh; background: var(--color-bg); }
.container { padding: 24rpx 32rpx; }

.section { padding: 28rpx; margin-bottom: 24rpx; box-shadow: var(--shadow-card); }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }

.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-item { width: 200rpx; height: 200rpx; border-radius: var(--radius-sm); overflow: hidden; position: relative; }
.photo-img { width: 100%; height: 100%; }
.photo-delete { position: absolute; top: 0; right: 0; width: 44rpx; height: 44rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.photo-add { width: 200rpx; height: 200rpx; border-radius: var(--radius-sm); border: 2rpx dashed var(--color-border); display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: var(--color-primary); }

.amount-wrap { display: flex; align-items: center; background: var(--color-bg); border-radius: var(--radius-sm); padding: 0 24rpx; height: 88rpx; }
.prefix { font-size: 36rpx; font-weight: 600; color: var(--color-primary); margin-right: 12rpx; }
.amount-input { flex: 1; font-size: 36rpx; font-weight: 600; height: 88rpx; }

.remark-input { width: 100%; min-height: 140rpx; background: var(--color-bg); border-radius: var(--radius-sm); padding: 20rpx; font-size: 28rpx; }

.submit-wrap { padding-top: 16rpx; }
.submit-btn { width: 100%; }
.tip-text { display: block; text-align: center; font-size: 22rpx; color: var(--color-text-light); margin-top: 16rpx; }
