/**
 * 猫屋首页样式 - 探探式卡片叠放 + 滑动飞出
 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 16rpx;
  position: relative;
  z-index: 20;
}

.header-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.title-text {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.title-desc {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-white);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 加载状态 */
.loading-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.paw-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.paw-icon {
  font-size: 80rpx;
  animation: pawBounce 1.2s ease-in-out infinite;
}

@keyframes pawBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.loading-text {
  color: var(--color-text-light);
  font-size: 28rpx;
}

/* 卡片叠放容器 */
.card-stack {
  flex: 1;
  position: relative;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
}

/* 所有卡片基础样式 */
.cat-card {
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  bottom: 180rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  will-change: transform, opacity;
  background: #f5f0eb;
}

/* 背景叠放卡片 - 加粗边框+阴影让叠放层次更明显 */
.stack-card {
  pointer-events: none;
  box-shadow: 
    0 2rpx 8rpx rgba(0, 0, 0, 0.06),
    0 0 0 3rpx rgba(0, 0, 0, 0.04);
}

/* 顶层可拖拽卡片 */
.draggable-card {
  z-index: 10;
  cursor: grab;
}

/* 全卡片背景照片 */
.cat-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 顶层卡片的可拖拽图片区域 */
.cat-card-draggable {
  z-index: 5;
}

/* 底部渐变遮罩 */
.card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 50%, transparent 100%);
  pointer-events: none;
}

/* 滑动标签（跳过/看看） */
.swipe-tag {
  position: absolute;
  top: 60rpx;
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  border: 6rpx solid;
  pointer-events: none;
  z-index: 5;
}

.skip-tag {
  left: 40rpx;
  color: #FF6B6B;
  border-color: #FF6B6B;
  transform-origin: left center;
}

.like-tag {
  right: 40rpx;
  color: #4ECDC4;
  border-color: #4ECDC4;
  transform-origin: right center;
}

/* 多张照片标记 */
.photo-count {
  position: absolute;
  bottom: 140rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(0,0,0,0.5);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
}

.photo-count-icon {
  font-size: 24rpx;
}

.photo-count-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

/* 猫咪信息叠加层 */
.cat-info-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-bottom: 40rpx;
}

.cat-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.cat-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.cat-gender {
  font-size: 40rpx;
  color: #5B9BD5;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.cat-gender.female {
  color: #FF85A2;
}

.cat-age {
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
}

.cat-address {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.address-icon {
  font-size: 24rpx;
}

.address-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

/* 操作按钮行 - fixed 定位，视觉位置与卡片底部对齐 */
.action-row {
  position: fixed;
  bottom: 32rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 80rpx;
  z-index: 100;
}

.swipe-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.btn-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.skip-btn .btn-icon {
  background: var(--color-bg);
  border: 3rpx solid var(--color-border);
}

.like-btn .btn-icon {
  background: linear-gradient(135deg, #FF8C42, #FF6B6B);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 107, 0.3);
}

.btn-label {
  font-size: 22rpx;
  color: var(--color-text-light);
}


/* 空状态引导 */
.empty-guide {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 64rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--color-text-light);
  margin-bottom: 48rpx;
  text-align: center;
}

.empty-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.guide-btn {
  width: 100%;
}
