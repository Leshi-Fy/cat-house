<!--
  编辑个人资料 / 添加家养猫
-->
<view class="page">
  <view class="container">
    <!-- 个人资料模式 -->
    <block wx:if="{{mode === 'profile'}}">
      <!-- 头像 -->
      <view class="section card">
        <view class="section-title">头像</view>
        <view class="avatar-wrap" bindtap="onChooseAvatar">
          <image class="avatar-img" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
          <text class="avatar-hint">点击更换</text>
        </view>
      </view>

      <view class="section card">
        <view class="form-item">
          <text class="form-label">昵称 *</text>
          <input class="form-input" placeholder="你的昵称" value="{{profile.nickName}}" bindinput="onInputNickName" />
        </view>
        <view class="form-item">
          <text class="form-label">简介</text>
          <textarea class="form-textarea" placeholder="介绍一下自己..." value="{{profile.bio}}" bindinput="onInputBio" maxlength="200" />
        </view>
        <view class="form-item">
          <text class="form-label">爱好</text>
          <input class="form-input" placeholder="如：摄影、撸猫" value="{{profile.hobbies}}" bindinput="onInputHobbies" />
        </view>
        <view class="form-item">
          <text class="form-label">喜欢的猫咪类型</text>
          <input class="form-input" placeholder="如：橘猫、英短、三花" value="{{profile.catPreference}}" bindinput="onInputCatPreference" />
        </view>
      </view>

      <view class="submit-wrap safe-bottom">
        <button class="btn-primary submit-btn" bindtap="onSaveProfile" disabled="{{submitting}}">
          保存资料
        </button>
      </view>
    </block>

    <!-- 添加家养猫模式 -->
    <block wx:if="{{mode === 'addCat'}}">
      <view class="section card">
        <view class="section-title">猫咪照片</view>
        <view class="photo-grid">
          <view class="photo-item" wx:for="{{catForm.photos}}" wx:key="index">
            <image class="photo-img" src="{{item}}" mode="aspectFill" />
            <view class="photo-delete" bindtap="onDeleteCatPhoto" data-index="{{index}}">✕</view>
          </view>
          <view class="photo-add" bindtap="addCatPhotos" wx:if="{{catForm.photos.length < 9}}">
            <text>+</text>
          </view>
        </view>
      </view>

      <view class="section card">
        <view class="form-item">
          <text class="form-label">名字 *</text>
          <input class="form-input" placeholder="猫咪的名字" value="{{catForm.name}}" bindinput="onCatNameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">品种</text>
          <input class="form-input" placeholder="如：英短蓝猫" value="{{catForm.breed}}" bindinput="onCatBreedInput" />
        </view>
        <view class="form-row">
          <view class="form-item half">
            <text class="form-label">年龄</text>
            <input class="form-input" placeholder="如：2岁" value="{{catForm.age}}" bindinput="onCatAgeInput" />
          </view>
          <view class="form-item half">
            <text class="form-label">性别</text>
            <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{catGenderIndex}}" bindchange="onCatGenderChange">
              <view class="form-picker">{{genderOptions[catGenderIndex].label}} ▾</view>
            </picker>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">性格</text>
          <textarea class="form-textarea" placeholder="描述猫咪的性格特点..." value="{{catForm.personality}}" bindinput="onCatPersonalityInput" maxlength="200" />
        </view>
      </view>

      <view class="submit-wrap safe-bottom">
        <button class="btn-primary submit-btn" bindtap="onSaveCat" disabled="{{submitting}}">
          {{submitting ? '保存中...' : '🐾 添加猫咪'}}
        </button>
      </view>
    </block>
  </view>
</view>
