.page { min-height: 100vh; background: var(--color-bg); }
.container { padding: 24rpx 32rpx; }

.section { padding: 28rpx; margin-bottom: 24rpx; box-shadow: var(--shadow-card); }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }

/* 头像 */
.avatar-wrap { display: flex; align-items: center; gap: 24rpx; }
.avatar-img { width: 120rpx; height: 120rpx; border-radius: 50%; }
.avatar-hint { font-size: 26rpx; color: var(--color-primary); }

/* 表单 */
.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; display: block; }
.form-input { width: 100%; height: 80rpx; background: var(--color-bg); border-radius: var(--radius-sm); padding: 0 24rpx; font-size: 28rpx; }
.form-textarea { width: 100%; min-height: 120rpx; background: var(--color-bg); border-radius: var(--radius-sm); padding: 16rpx 24rpx; font-size: 28rpx; line-height: 1.6; }
.form-picker { width: 100%; height: 80rpx; background: var(--color-bg); border-radius: var(--radius-sm); padding: 0 24rpx; font-size: 28rpx; display: flex; align-items: center; }
.form-row { display: flex; gap: 20rpx; }
.form-item.half { flex: 1; }

/* 照片 */
.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-item { width: 180rpx; height: 180rpx; border-radius: var(--radius-sm); overflow: hidden; position: relative; }
.photo-img { width: 100%; height: 100%; }
.photo-delete { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.photo-add { width: 180rpx; height: 180rpx; border-radius: var(--radius-sm); border: 2rpx dashed var(--color-border); display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: var(--color-primary); }

.submit-wrap { padding-top: 16rpx; }
.submit-btn { width: 100%; }
