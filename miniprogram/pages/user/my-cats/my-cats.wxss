.page { min-height: 100vh; background: var(--color-bg); }
.container { padding: 24rpx 32rpx; }

.cat-item { display: flex; gap: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.cat-avatar { width: 120rpx; height: 120rpx; border-radius: var(--radius-sm); flex-shrink: 0; }
.cat-info { flex: 1; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.cat-name { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.cat-meta { display: flex; gap: 12rpx; font-size: 24rpx; color: var(--color-text-secondary); margin-bottom: 4rpx; }
.cat-personality { font-size: 24rpx; color: var(--color-text-light); }
.cat-arrow { display: flex; align-items: center; flex-shrink: 0; padding-left: 12rpx; }
.arrow-icon { font-size: 40rpx; color: var(--color-text-light); line-height: 1; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 160rpx 64rpx; gap: 16rpx; }
.empty-icon { font-size: 80rpx; }
.empty-text { color: var(--color-text-light); font-size: 28rpx; margin-bottom: 32rpx; }

.fab { position: fixed; right: 40rpx; bottom: calc(80rpx + env(safe-area-inset-bottom)); width: 100rpx; height: 100rpx; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light)); box-shadow: 0 8rpx 24rpx rgba(255, 140, 66, 0.4); display: flex; align-items: center; justify-content: center; z-index: 100; }
.fab-icon { color: #fff; font-size: 48rpx; font-weight: 300; margin-top: -4rpx; }
