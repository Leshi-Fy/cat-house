/* pages/user/my-feeds/my-feeds.wxss */
.container {
  padding: 0 0 40rpx;
  background: #FFF8F0;
  min-height: 100vh;
}

/* 顶部操作栏 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f0eb;
  position: sticky;
  top: 0;
  z-index: 10;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.post-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
}

.post-icon {
  font-size: 32rpx;
  color: #fff;
  line-height: 1;
}

.post-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* 动态列表 */
.feed-list {
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 动态头部：时间 + 操作按钮 */
.feed-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.feed-time {
  font-size: 24rpx;
  color: #bbb;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.edit-btn {
  color: #FF8C42;
  background: #FFF3E8;
}

.delete-btn {
  color: #FF4D4D;
  background: #FFF0F0;
}

/* 关联猫咪 */
.linked-cat {
  display: flex;
  align-items: center;
  background: #FFF5F0;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.cat-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.cat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.cat-breed {
  font-size: 26rpx;
  color: #666;
  margin-top: 4rpx;
}

.link-arrow {
  font-size: 44rpx;
  color: #ccc;
  line-height: 1;
  flex-shrink: 0;
}

/* 动态内容 */
.feed-content {
  margin-bottom: 20rpx;
}

.feed-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.feed-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.feed-image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f5f0eb;
}

.feed-image.single {
  width: 100%;
  max-width: 440rpx;
  height: 360rpx;
}

/* 统计数据 */
.feed-stats {
  display: flex;
  gap: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f0eb;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-num {
  font-size: 26rpx;
  color: #999;
}

/* 没有更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
  border: none;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 100rpx;
  color: #bbb;
  font-size: 28rpx;
}

/* 加载失败 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: #FF4D4D;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  border: none;
}
