.page { min-height: 100vh; background: var(--color-bg); }
.container { padding: 24rpx 32rpx; }

.cat-item { display: flex; gap: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.cat-thumb { width: 120rpx; height: 120rpx; border-radius: var(--radius-sm); flex-shrink: 0; }
.cat-info { flex: 1; min-width: 0; }
.cat-name-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.cat-name { font-size: 30rpx; font-weight: 600; }
.merge-badge { font-size: 20rpx; color: var(--color-primary); background: rgba(255, 140, 66, 0.1); padding: 2rpx 12rpx; border-radius: 12rpx; }
.alias-text { font-size: 22rpx; color: var(--color-text-secondary); margin-bottom: 6rpx; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tag-row { display: flex; gap: 8rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 160rpx 64rpx; gap: 16rpx; }
.empty-icon { font-size: 80rpx; }
.empty-text { color: var(--color-text-light); font-size: 28rpx; margin-bottom: 32rpx; }
