<!--
  消息中心：赞 / 评论 / 捐款 三个 Tab
  每条通知关联社区里的动态或众筹，点击跳转到对应详情页
-->
<view class="page page-with-tabbar">

  <!-- Tab 切换（默认「全部」，按时间倒序混合展示赞 / 评论 / 捐款） -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === 'all' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="all"
    >
      <text class="tab-text">全部</text>
      <view class="tab-badge" wx:if="{{unread.total > 0}}">{{unread.total > 99 ? '99+' : unread.total}}</view>
    </view>
    <view
      class="tab-item {{activeTab === 'like' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="like"
    >
      <text class="tab-text">赞</text>
      <view class="tab-badge" wx:if="{{unread.likeCount > 0}}">{{unread.likeCount > 99 ? '99+' : unread.likeCount}}</view>
    </view>
    <view
      class="tab-item {{activeTab === 'comment' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="comment"
    >
      <text class="tab-text">评论</text>
      <view class="tab-badge" wx:if="{{unread.commentCount > 0}}">{{unread.commentCount > 99 ? '99+' : unread.commentCount}}</view>
    </view>
    <view
      class="tab-item {{activeTab === 'donate' ? 'active' : ''}}"
      bindtap="switchTab"
      data-tab="donate"
    >
      <text class="tab-text">捐款</text>
      <view class="tab-badge" wx:if="{{unread.donateCount > 0}}">{{unread.donateCount > 99 ? '99+' : unread.donateCount}}</view>
    </view>

    <!-- 全部标为已读 -->
    <view class="mark-all-btn" bindtap="markAllRead" wx:if="{{unread.total > 0}}">
      <text class="mark-all-text">全部已读</text>
    </view>
  </view>

  <!-- 通知列表 -->
  <view class="list-wrap">

    <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{isLoading && items.length === 0}}">
      <text class="paw-icon">🐾</text>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-wrap" wx:elif="{{!isLoading && items.length === 0}}">
      <text class="empty-icon">🔔</text>
      <text class="empty-text">{{emptyText}}</text>
      <text class="empty-tip">别人点赞、评论你的动态或众筹后会出现在这里</text>
    </view>

    <!-- 通知列表 -->
    <view wx:else>
      <view
        class="notify-item {{item.isRead ? '' : 'unread'}}"
        wx:for="{{items}}"
        wx:key="_id"
        bindtap="onItemTap"
        data-item="{{item}}"
      >
        <!-- 头像 -->
        <view class="avatar-wrap">
          <image class="avatar" src="{{item.senderAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <!-- 类型图标 -->
          <view class="type-icon {{item.type}}">
            <text wx:if="{{item.type === 'like'}}">❤️</text>
            <text wx:elif="{{item.type === 'comment'}}">💬</text>
            <text wx:else>💰</text>
          </view>
        </view>

        <!-- 内容 -->
        <view class="notify-body">
          <view class="notify-top">
            <!-- 自己发出的互动不显示发送人（文案里已含「你」） -->
            <text class="sender-name" wx:if="{{!item.isSelf}}">{{item.senderName}}</text>
            <text class="notify-action {{item.isSelf ? 'self' : ''}}">{{item.actionText}}</text>
            <text class="notify-tag" wx:if="{{item.targetType === 'crowd' && !item.isSelf}}">众筹</text>
            <text class="notify-time">{{item.formattedTime}}</text>
          </view>

          <!-- 捐款金额 -->
          <view class="notify-donate-amount" wx:if="{{item.type === 'donate'}}">+¥{{item.amountDisplay}}</view>

          <!-- 评论正文 -->
          <view class="notify-quote strong" wx:if="{{item.commentContent}}">{{item.commentContent}}</view>

          <!-- 关联内容摘要（动态正文 / 众筹标题） -->
          <view
            class="notify-quote"
            wx:if="{{item.targetTitle && item.targetTitle !== item.commentContent}}"
          >{{item.targetTitle}}</view>

          <!-- 目标已被删除 -->
          <view class="notify-deleted" wx:if="{{!item.targetExists}}">
            <text>内容已删除</text>
          </view>
        </view>

        <!-- 关联内容缩略图 -->
        <view class="notify-thumb" wx:if="{{item.targetPhoto}}">
          <image class="thumb-img" src="{{item.targetPhoto}}" mode="aspectFill" lazy-load />
        </view>

        <!-- 未读红点 -->
        <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
      </view>

      <!-- 上滑到底自动加载更早的 10 条（也可点击手动触发） -->
      <view class="load-more" wx:if="{{hasMore}}">
        <view class="load-more-btn" bindtap="loadMore" wx:if="{{!isLoading}}">上滑加载更多</view>
        <text class="loading-more-text" wx:else>加载中...</text>
      </view>
      <view class="no-more" wx:else>
        <text>— 已全部加载 —</text>
      </view>
    </view>
  </view>

</view>
