/**
 * 消息中心样式
 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* Tab */
.tabs {
  display: flex;
  align-items: center;
  background: var(--color-white);
  border-bottom: 1rpx solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 0 8rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  position: relative;
}

.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.tab-text {
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.tab-badge {
  background: #FF4D4F;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
  line-height: 1.4;
}

.mark-all-btn {
  padding: 0 24rpx;
}

.mark-all-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 通知列表 */
.list-wrap {
  padding: 0;
}

.loading-wrap,
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.paw-icon,
.empty-icon {
  font-size: 80rpx;
}

.loading-text,
.empty-text {
  font-size: 28rpx;
  color: var(--color-text-light);
}

.empty-tip {
  font-size: 24rpx;
  color: var(--color-text-light);
  padding: 0 60rpx;
  text-align: center;
  line-height: 1.6;
}

/* 单条通知 */
.notify-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--color-white);
  border-bottom: 1rpx solid var(--color-border);
  position: relative;
}

.notify-item.unread {
  background: #FFF8F2;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-bg);
}

.type-icon {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  border: 2rpx solid var(--color-border);
  box-sizing: border-box;
}

.notify-body {
  flex: 1;
  min-width: 0;
}

.notify-top {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.sender-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.notify-time {
  font-size: 22rpx;
  color: var(--color-text-light);
  flex-shrink: 0;
  margin-left: auto;
}

.notify-action {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 自己发出的互动（发帖人本人的点赞 / 评论） */
.notify-action.self {
  color: var(--color-text);
  font-weight: 500;
}

.notify-tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background: rgba(255, 140, 66, 0.12);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.notify-quote {
  font-size: 24rpx;
  color: var(--color-text-light);
  background: var(--color-bg);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 评论正文：比内容摘要更突出 */
.notify-quote.strong {
  color: var(--color-text);
  background: rgba(255, 140, 66, 0.08);
  margin-bottom: 8rpx;
}

/* 目标已删除 */
.notify-deleted {
  display: inline-block;
  font-size: 22rpx;
  color: var(--color-text-light);
  border: 1rpx dashed var(--color-border);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

/* 关联内容缩略图 */
.notify-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-bg);
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.notify-donate-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8C42;
  margin-bottom: 8rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF4D4F;
  flex-shrink: 0;
  margin-top: 8rpx;
}

/* 加载更多 */
.load-more {
  padding: 32rpx 0;
  text-align: center;
}

.load-more-btn {
  display: inline-block;
  font-size: 26rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  padding: 12rpx 48rpx;
  border-radius: 40rpx;
}

.loading-more-text {
  font-size: 26rpx;
  color: var(--color-text-light);
}

.no-more {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-light);
}
