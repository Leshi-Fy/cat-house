.page { min-height: 100vh; }

/* 用户头部 */
.user-header {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  padding: 60rpx 32rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
}

.user-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.user-avatar {
  width: 100%;
  height: 100%;
}

.user-avatar-wrap.default {
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.default-avatar-text {
  font-size: 56rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.user-bio {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-top: 6rpx;
}

.login-btn {
  background: rgba(255, 255, 255, 0.2) !important;
  color: #fff !important;
  border: 2rpx solid rgba(255, 255, 255, 0.4) !important;
  font-size: 28rpx !important;
  border-radius: 40rpx !important;
}

.edit-btn {
  position: absolute;
  top: 60rpx;
  right: 32rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 菜单 */
.menu-list {
  padding: 24rpx 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-text {
  display: flex;
  flex-direction: column;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 500;
}

.menu-desc {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--color-text-light);
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.footer-text {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 30rpx;
}

.logout-btn {
  background: #fff;
  color: #FF6B35;
  font-size: 30rpx;
  padding: 30rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #FF6B35;
}
