.page {
  min-height: 100vh;
  background: #FFF8F0;
  padding: 24rpx;
  box-sizing: border-box;
}
.page-tip { font-size: 24rpx; color: #999; margin-bottom: 20rpx; line-height: 1.5; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-head { display: flex; justify-content: space-between; align-items: center; }
.card-title { display: flex; align-items: baseline; gap: 16rpx; }
.cat-name { font-size: 30rpx; font-weight: 600; color: #333; }
.amount { font-size: 34rpx; font-weight: 700; color: #FF6B35; }
.status { font-size: 24rpx; color: #FF8C42; background: #FFF1E6; padding: 4rpx 16rpx; border-radius: 20rpx; }

.card-meta { display: flex; flex-direction: column; font-size: 24rpx; color: #888; margin: 16rpx 0; gap: 6rpx; }
.remark { font-size: 26rpx; color: #666; background: #f9f9f9; padding: 16rpx; border-radius: 12rpx; margin-bottom: 16rpx; }

.receipts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.receipt-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #eee; }

.actions { display: flex; gap: 20rpx; }
.btn { flex: 1; font-size: 30rpx; border-radius: 40rpx; margin: 0; }
.btn::after { border: none; }
.approve { background: #07c160; color: #fff; }
.reject { background: #fff; color: #FF6B35; border: 1rpx solid #FF6B35; }

.empty-state { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }
